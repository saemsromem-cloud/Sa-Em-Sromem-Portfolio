# Copy to .env and fill in. Never commit .env.

# Required. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin login. Generate the hash with:  python scripts/generate_password_hash.py
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Public URL of the deployed site (used for canonical links, sitemap and social previews).
SITE_URL=https://your-domain.example

# Set to true when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Optional: where the SQLite file lives. Defaults to instance/messages.db
# DATABASE_PATH=

# Local development only: enables the debugger and auto-reload.
# FLASK_DEBUG=1
